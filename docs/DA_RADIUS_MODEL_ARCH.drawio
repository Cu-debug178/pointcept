        <mxCell id="da_radius" value="DA-Radius&#xa;DensityAdaptiveRadius&#xa;&#xa;density_i = 1 / mean_dist_i&#xa;radius_scale_i = f(density_i)&#xa;radius_i = base_radius_stage × scale_i&#xa;&#xa;backend: cuda / torch" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#361b00;strokeColor=#f0883e;strokeWidth=2;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1">
