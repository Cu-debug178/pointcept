        <mxCell id="leg_global" value="SGCA serialized patch&#xa;global context" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e8f5e9;strokeColor=#43a047;strokeWidth=3;fontSize=18;" vertex="1" parent="1"><mxGeometry x="170" y="340" width="330" height="75" as="geometry"/></mxCell>
        <mxCell id="leg_router" value="Router / difficulty weight" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff8e1;strokeColor=#f9a825;strokeWidth=3;fontSize=18;" vertex="1" parent="1"><mxGeometry x="170" y="450" width="330" height="75" as="geometry"/></mxCell>
        <mxCell id="leg_decoder" value="Decoder / Up / Grid Up" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f3e5f5;strokeColor=#8e24aa;strokeWidth=3;fontSize=18;" vertex="1" parent="1"><mxGeometry x="170" y="560" width="330" height="75" as="geometry"/></mxCell>
