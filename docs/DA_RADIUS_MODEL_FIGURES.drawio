        <mxCell id="switches" value="use_da_radius / enable_da_radius&#xa;da_radius_backend = 'cuda' or 'torch'&#xa;da_radius_stages = (2,3,4)&#xa;use_da_kernel / enable_da&#xa;use_global_context / enable_global&#xa;global_context_type = serialized_patch&#xa;router_stages = (2,3,4)&#xa;enable_refine" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#777777;strokeWidth=2;fontSize=19;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="765" y="230" width="350" height="400" as="geometry"/></mxCell>
        <mxCell id="mapping" value="kpconvx_hybrid.py&#xa;  - final forward path&#xa;  - router-guided SGCA fusion&#xa;&#xa;kpx_stage2.py&#xa;  - _build_pyramid()&#xa;  - DA scale / DA radius&#xa;&#xa;torch_pyramid.py&#xa;  - pyramid neighbor construction&#xa;&#xa;libs/pointops/functions/query.py&#xa;  - adaptive_ball_query Python binding&#xa;&#xa;libs/pointops/src/ball_query/*&#xa;  - CUDA/C++ implementation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#777777;strokeWidth=2;fontSize=18;align=left;spacing=16;" vertex="1" parent="1"><mxGeometry x="1325" y="220" width="360" height="465" as="geometry"/></mxCell>
