        <mxCell id="kernel_col" value="DA-Kernel Ablation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;strokeWidth=3;fontSize=26;fontStyle=1;align=center;verticalAlign=top;spacingTop=18;" vertex="1" parent="1"><mxGeometry x="825" y="110" width="650" height="650" as="geometry"/></mxCell>
        <mxCell id="radius_col" value="DA-Radius Main Change" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=3;fontSize=26;fontStyle=1;align=center;verticalAlign=top;spacingTop=18;" vertex="1" parent="1"><mxGeometry x="1570" y="110" width="650" height="650" as="geometry"/></mxCell>
        <mxCell id="base_neigh" value="Fixed ball query&#xa;base_radius_l" style="ellipse;html=1;whiteSpace=wrap;fillColor=none;strokeColor=#999999;strokeWidth=4;fontSize=18;" vertex="1" parent="1"><mxGeometry x="170" y="250" width="220" height="220" as="geometry"/></mxCell>
        <mxCell id="base_features" value="Neighbor Features&#xa;H x C" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#e53935;strokeWidth=3;fontSize=18;" vertex="1" parent="1"><mxGeometry x="430" y="280" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="base_kpx" value="KPConvX&#xa;kernel attention&#xa;sum" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e3f2fd;strokeColor=#1e88e5;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="440" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="kernel_scale" value="DensityAdaptiveScale&#xa;s_i in [0.5, 2.0]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe0b2;strokeColor=#ef6c00;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="210" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="kernel_formula" value="kernel points:&#xa;p_k_da = s_i * p_k&#xa;neighbors unchanged" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=18;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1030" y="365" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="kernel_block" value="DAKPNextMultiShortcutBlock&#xa;da_scale passed into DAKPConvX" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e3f2fd;strokeColor=#1e88e5;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="545" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="radius_scale" value="DensityAdaptiveRadius&#xa;scale_i in [0.8, 1.5]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#c8e6c9;strokeColor=#2e7d32;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1680" y="210" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="radius_formula" value="query radius:&#xa;r_i = radius_l * scale_i&#xa;neighbors rebuilt by CUDA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=18;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1785" y="365" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="radius_block" value="adaptive_ball_query&#xa;per-point radius tensor&#xa;new neighbors feed KPConvX" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1765" y="545" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="compare_note" value="建议论文叙述：DA-Radius 改变 local graph construction，是主贡献；DA-Kernel 改变 kernel projection / influence，可作为独立消融。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;strokeWidth=2;fontSize=20;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="260" y="830" width="1750" height="90" as="geometry"/></mxCell>
        <mxCell id="e_base_feat_kpx" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="base_features" target="base_kpx"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_kernel_scale_formula" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="kernel_scale" target="kernel_formula"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_kernel_formula_block" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="kernel_formula" target="kernel_block"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_radius_scale_formula" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="radius_scale" target="radius_formula"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_radius_formula_block" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="radius_formula" target="radius_block"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="global-router-refine" name="Fig4 SGCA Router Refine">
    <mxGraphModel dx="2300" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2050" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="fig4_title" value="全局上下文、难度路由与解码细化模块说明" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;fontFamily=Times New Roman;align=center;" vertex="1" parent="1"><mxGeometry x="270" y="25" width="1500" height="50" as="geometry"/></mxCell>
        <mxCell id="sgca_panel" value="A. SGCALite / Serialized Patch Attention" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;strokeWidth=3;fontSize=24;fontStyle=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="850" height="430" as="geometry"/></mxCell>
        <mxCell id="router_panel" value="B. GeometryDifficultyRouter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;strokeWidth=3;fontSize=24;fontStyle=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1010" y="110" width="900" height="430" as="geometry"/></mxCell>
        <mxCell id="refine_panel" value="C. DecoderRefineHead" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#e53935;strokeWidth=3;fontSize=24;fontStyle=1;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="330" y="650" width="1350" height="300" as="geometry"/></mxCell>
        <mxCell id="sgca_in" value="stage feats + coords&#xa;[N_l, C_l]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="120" y="235" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="sgca_order" value="serialization order&#xa;xyz sort proxy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#c8e6c9;strokeColor=#2e7d32;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="220" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="sgca_patch" value="split patches&#xa;patch_size 192 / 320" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#c8e6c9;strokeColor=#2e7d32;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="220" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="sgca_attn" value="MultiheadAttention&#xa;+ MLP residual" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e3f2fd;strokeColor=#1e88e5;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="455" y="370" width="220" height="85" as="geometry"/></mxCell>
        <mxCell id="router_stats" value="neighbor stats&#xa;mean_dist, dist_var, feat_var" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="210" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="router_mlp" value="router MLP&#xa;difficulty_head" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff8e1;strokeColor=#f9a825;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1410" y="210" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="router_weight" value="global_weight&#xa;sigmoid(logit + boost*difficulty)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe0b2;strokeColor=#ef6c00;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1660" y="210" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="fusion_formula" value="f_out = f + global_weight * (SGCA(f) - f)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=20;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="1210" y="390" width="520" height="70" as="geometry"/></mxCell>
        <mxCell id="ref_in" value="decoder features&#xa;+ original coords&#xa;+ stage-1 neighbors" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="420" y="760" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="ref_boundary" value="boundary / local contrast cues" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffcdd2;strokeColor=#c62828;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="760" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="ref_fuse" value="lightweight residual refine" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffcdd2;strokeColor=#c62828;strokeWidth=3;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="760" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="ref_out" value="refined logits input" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1400" y="760" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="e_sgca1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="sgca_in" target="sgca_order"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sgca2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="sgca_order" target="sgca_patch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sgca3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="sgca_patch" target="sgca_attn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_router1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="router_stats" target="router_mlp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_router2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="router_mlp" target="router_weight"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_router3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="router_weight" target="fusion_formula"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ref1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="ref_in" target="ref_boundary"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ref2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="ref_boundary" target="ref_fuse"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ref3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;strokeWidth=3;" edge="1" parent="1" source="ref_fuse" target="ref_out"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
